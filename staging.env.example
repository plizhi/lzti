# Staging 环境配置模板
# 复制此文件为 .env.staging 并填入实际值

# Database - Staging
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lzti_staging?schema=public"

# JWT Secret - 必须修改为随机值
JWT_SECRET="lzti-staging-secret-change-in-production"

# nzyy Portal API
NZYY_API_URL="https://nzyy.cc/api"

# 体系账号 SSO（望杏成林账号中心）
# 五个变量缺一不可：缺任意一个，登录页不渲染「体系账号登录」入口，
# SSO 接口返回「未配置」。未开通 SSO 的环境保持全部注释即可（安全降级）。
# 注意：登录页是服务端组件静态化，这些值在 build 时烘进产物，
# 改完必须重新 build 才生效。
#
# AUTH_BASE_URL        认证服务地址
# CLIENT_ID            认证服务登记的 client_id（生产 lzti / 开发 lzti-dev）
# CLIENT_LZTI_SECRET   client 对应的密钥
# LZTI_REDIRECT_URI    回调地址，必须与认证服务登记的完全一致
# JWT_ISSUER           token 的 issuer，必须与认证服务的 JWT_ISSUER 一致
# AUTH_BASE_URL="https://auth.nzyy.cc"
# CLIENT_ID="lzti"
# CLIENT_LZTI_SECRET=""
# LZTI_REDIRECT_URI="https://lzti.nzyy.cc/api/auth/callback"
# JWT_ISSUER="https://auth.nzyy.cc"

# Sentry (Optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
