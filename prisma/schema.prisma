generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户
// PENDING: 预账户，激活邀请码后创建，无手机号密码
// ACTIVE: 正式账户，注册后升级
model User {
  id            String    @id @default(cuid())
  phone         String?   @unique
  passwordHash  String?
  status        String    @default("PENDING")  // PENDING / ACTIVE
  name          String?
  role          String    @default("PARENT")
  shareBatchId  String?   // 来自哪个分享批次
  children      Child[]
  createdAt     DateTime  @default(now())
  expiresAt     DateTime? // PENDING 状态过期时间（测评完成后2小时）
  updatedAt     DateTime  @updatedAt
}

// 分享批次
// 老用户一次分享，携带多个 Slot
model ShareBatch {
  id                  String   @id @default(cuid())
  userId              String   // 分享者
  stageId             String   // 学段
  questionnaireType   String   // 问卷类型：register / student / teacher
  slots               Slot[]
  createdAt           DateTime @default(now())
  expiresAt           DateTime // 分享链接过期时间（2天）

  @@index([userId])
}

// 邀请槽位
// 每个 Slot 对应一个邀请码或测评机会
model Slot {
  id          String    @id @default(cuid())
  batchId    String
  batch      ShareBatch @relation(fields: [batchId], references: [id])
  type       String    // register / student / teacher
  code       String    @unique  // 激活码，6位数字
  usedBy     String?   // 使用者 userId
  usedAt     DateTime?
  childId    String?   // 关联的孩子（测评用）
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([batchId])
  @@index([code])
}

// 孩子
model Child {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  name             String
  gender           String?
  birthDate        DateTime?
  grade            String?
  sessions         AssessmentSession[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
}

// 测评会话
model AssessmentSession {
  id        String           @id @default(cuid())
  childId   String
  child     Child            @relation(fields: [childId], references: [id])
  stageId   String
  completed String           @default("{\"parent\":false,\"student\":false,\"teacher\":false}")
  slotId    String?         // 通过哪个 Slot 创建
  attempts  SessionAttempt[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([childId])
  @@index([slotId])
}

// 测评尝试
model SessionAttempt {
  id                String        @id @default(cuid())
  sessionId         String
  session           AssessmentSession @relation(fields: [sessionId], references: [id])
  childId           String
  questionnaireType String
  stageId           String
  answers           Json
  scores            Json
  quadrants         Json
  report            AttemptReport?
  createdAt         DateTime      @default(now())

  @@index([sessionId])
  @@index([childId])
}

// 测评报告
model AttemptReport {
  id            String   @id @default(cuid())
  attemptId     String   @unique
  attempt       SessionAttempt @relation(fields: [attemptId], references: [id])
  currentStatus Json
  trendAnalysis Json?
  trajectory    Json
  suggestions   Json
  createdAt     DateTime @default(now())
}

// 报告分享
// 用于生成只读分享链接
model ReportShare {
  id          String   @id @default(cuid())
  attemptId   String   @unique  // 关联 SessionAttempt
  ownerId     String   // 分享者 userId
  shareCode   String   @unique  // 8位字母数字码
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([shareCode])
  @@index([attemptId])
  @@index([ownerId])
}

// 用户邀请码池（动态生成的邀请码）
model UserInviteCode {
  id          String   @id @default(cuid())
  userId      String   // 拥有者
  code        String   @unique
  usedBy      String?  // 使用者
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([code])
}
