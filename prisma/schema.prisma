generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 用户
// PENDING: 预账户，激活邀请码后创建，无手机号密码
// ACTIVE: 正式账户，注册后升级
model User {
  id            String    @id @default(cuid())
  phone         String?   @unique
  passwordHash  String?
  status        String    @default("PENDING")  // PENDING / ACTIVE
  name          String?
  role          String    @default("PARENT")
  shareBatchId  String?   // 来自哪个分享批次
  children      Child[]

  // 分享相关
  shareCode      String?   @unique  // 用户的唯一分享码
  bonusAttempts  Int      @default(0)  // 通过分享获得的额外测评次数（保留兼容）
  bonusUsed      Int      @default(0)  // 已使用的分享奖励次数（保留兼容）

  // 积分体系
  realPoints     Int      @default(0)    // 实际积分
  bonusPoints    Int      @default(0)    // 奖励积分（已付费用户满10奖2）
  bonusPointsUsed Int     @default(0)    // 已使用的奖励积分

  createdAt     DateTime  @default(now())
  expiresAt     DateTime? // PENDING 状态过期时间（测评完成后2小时）
  updatedAt     DateTime  @updatedAt

  // 关联
  subscriptions Subscription[]
  payments      Payment[]
  referralReceived Referral[] @relation("Referrer")
  shareRewards  ShareReward[]
  pointTransactions PointTransaction[]
  coupons       Coupon[]
}

// 分享批次
// 老用户一次分享，携带多个 Slot
model ShareBatch {
  id                  String   @id @default(cuid())
  userId              String   // 分享者
  stageId             String   // 学段
  questionnaireType   String   // 问卷类型：register / student / teacher
  slots               Slot[]
  createdAt           DateTime @default(now())
  expiresAt           DateTime // 分享链接过期时间（2天）

  @@index([userId])
}

// 邀请槽位
// 每个 Slot 对应一个邀请码或测评机会
model Slot {
  id          String    @id @default(cuid())
  batchId    String
  batch      ShareBatch @relation(fields: [batchId], references: [id])
  type       String    // register / student / teacher
  code       String    @unique  // 激活码，6位数字
  usedBy     String?   // 使用者 userId
  usedAt     DateTime?
  childId    String?   // 关联的孩子（测评用）
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([batchId])
  @@index([code])
}

// 孩子
model Child {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  name             String
  gender           String?
  birthDate        DateTime?
  grade            String?
  sessions         AssessmentSession[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
}

// 测评会话
model AssessmentSession {
  id        String           @id @default(cuid())
  childId   String
  child     Child            @relation(fields: [childId], references: [id])
  stageId   String
  completed String           @default("{\"parent\":false,\"student\":false,\"teacher\":false}")
  slotId    String?         // 通过哪个 Slot 创建
  couponId  String?          // 使用的券ID（荔心卷/升学指数/trial）
  attempts  SessionAttempt[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([childId])
  @@index([slotId])
  @@index([couponId])
}

// 测评尝试
model SessionAttempt {
  id                    String        @id @default(cuid())
  sessionId             String
  session               AssessmentSession @relation(fields: [sessionId], references: [id])
  childId               String
  questionnaireType     String
  stageId               String
  answers               Json
  scores                Json
  quadrants             Json
  // 中途保存 - 进度
  progress              Json?         // 存储中途答案 { dimensionId: { questionId: score } }
  currentDimensionIndex Int?          // 当前维度索引
  updatedAt             DateTime      @updatedAt
  // 提交后
  report                AttemptReport?
  createdAt             DateTime      @default(now())

  @@index([sessionId])
  @@index([childId])
}

// 测评报告
model AttemptReport {
  id            String   @id @default(cuid())
  attemptId     String   @unique
  attempt       SessionAttempt @relation(fields: [attemptId], references: [id])
  currentStatus Json
  trendAnalysis Json?
  trajectory    Json
  suggestions   Json
  createdAt     DateTime @default(now())
}

// 报告分享
// 用于生成只读分享链接
model ReportShare {
  id          String   @id @default(cuid())
  attemptId   String   @unique  // 关联 SessionAttempt
  ownerId     String   // 分享者 userId
  shareCode   String   @unique  // 8位字母数字码
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([shareCode])
  @@index([attemptId])
  @@index([ownerId])
}

// 用户邀请码池（动态生成的邀请码）
model UserInviteCode {
  id          String   @id @default(cuid())
  userId      String   // 拥有者
  code        String   @unique
  usedBy      String?  // 使用者
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([code])
}

// 用户反馈
model Feedback {
  id          String    @id @default(cuid())
  userId      String?
  content     String
  category    String    // suggestion / bug / complaint / inquiry
  status      String    @default("pending") // pending / processing / resolved
  contact     String?
  autoReply   String?
  reply       String?
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([category])
  @@index([status])
}

// ============================================
// 会员订阅系统
// ============================================

// 订阅表
model Subscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String   // "yearly"
  status         String   // "active" | "expired" | "cancelled"
  attemptsTotal  Int      @default(12)   // 年度总次数
  attemptsUsed   Int      @default(0)    // 已使用次数
  startsAt       DateTime
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
  @@index([status])
}

// 支付记录
model Payment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  amount         Int       // 分（19900 = 199元）
  currency       String    @default("CNY")
  status         String    // "pending" | "completed" | "failed" | "refunded"
  provider       String    // "stripe" | "gumroad" | "manual"
  transactionId  String?   // 第三方流水号
  paymentUrl     String?   // 支付页面 URL
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([transactionId])
  @@index([status])
}

// 复测提醒
model ReTestReminder {
  id          String    @id @default(cuid())
  userId      String
  childId     String
  attemptId   String    // 基于哪个测评
  remindAt    DateTime  // 计划提醒时间
  sentAt      DateTime? // 实际发送时间
  channel     String    @default("in_app") // "in_app" | "wechat" | "sms" | "email"
  status      String    @default("pending") // "pending" | "sent" | "failed" | "cancelled"
  createdAt   DateTime  @default(now())

  @@index([userId, remindAt])
  @@index([status])
}

// ============================================
// 分享激励机制
// ============================================

// 邀请关系（核心）
model Referral {
  id              String    @id @default(cuid())
  referrerId      String    // 分享者
  referrer        User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId       String?   // 被分享者（注册后填充）
  shareCode       String    // 分享码
  referredAt      DateTime  @default(now())  // 被分享时间

  // 积分奖励状态
  pointsRegistered Boolean   @default(false) // 注册积分奖励已发放（+5积分）
  pointsAssessed   Boolean   @default(false) // 测评积分奖励已发放（+3积分/次）
  rewardSubscribed Boolean   @default(false) // 订阅奖励已发放（+1月/+1次测评/trial券）

  createdAt       DateTime  @default(now())

  @@index([referrerId])
  @@index([refereeId])
  @@index([shareCode])
}

// 分享奖励记录
model ShareReward {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralId  String
  type        String   // "registered" | "assessed" | "subscribed"
  bonusCount  Int      // 奖励次数（1或3）
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([referralId])
}

// 分享记录日志
model ShareLog {
  id          String   @id @default(cuid())
  userId      String
  shareCode   String   // 使用的分享码
  childId     String?  // 被分享的孩子ID（如果有）
  type        String   // "link" | "poster" | "qrcode"
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([shareCode])
}

// ============================================
// 积分体系
// ============================================

// 积分流水
model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // earn_register | earn_assessment | redeem_lixin | redeem_shengxue | bonus_earned
  amount      Int      // 正数=获得，负数=消耗
  balance     Int      // 变动后的余额
  description String?  // 说明
  relatedId   String?  // 关联ID
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// 券（荔心卷/升学指数/trial试用）
model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique  // 券码，如 LX-XXXXXXXX、TR-XXXXXXXX
  type        String   // lixin | shengxue | trial
  status      String   @default("active") // active | used | expired
  userId      String?  // 拥有者
  user        User?    @relation(fields: [userId], references: [id])
  usedBy      String?  // 使用者
  usedAt      DateTime?
  sessionId   String?  // 关联的测评session
  expiresAt   DateTime // 过期时间
  createdAt   DateTime @default(now())

  @@index([code])
  @@index([userId])
  @@index([status])
}
